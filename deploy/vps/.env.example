# Production settings for one OpenMausBot server on a VPS (deploy/vps/README.md).
# bootstrap.sh writes deploy/vps/.env from its flags; edit that file afterwards
# and run update.sh to apply.

# Public hostname. Its A (and AAAA, if any) record must point at this server
# before the first start, or Caddy cannot get a certificate.
DOMAIN=maus.example.com

# Engine CLIs baked into the image (space-separated npm packages). Sign each in
# afterwards with: deploy/vps/omb login claude   (or codex)
ENGINES=@anthropic-ai/claude-code @openai/codex

# Who may sign in at https://DOMAIN/pair with an emailed code. Addresses or
# @domain entries, comma-separated. Admins get full access, members chat and
# approvals only. Empty: pairing codes only.
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=

# Runs every bot turn in its own bubblewrap sandbox with a filtered network
# (docs/bot-box.md). 1 on, 0 off.
OMB_BOT_BOX=1

# Optional off-site copy of the nightly backup, as an rsync-over-SSH target,
# e.g. u123456@u123456.your-storagebox.de:openmausbot/ (port in BACKUP_SSH_PORT).
BACKUP_OFFSITE=
BACKUP_SSH_PORT=23
# Local archives older than this many days are deleted.
BACKUP_KEEP_DAYS=14
